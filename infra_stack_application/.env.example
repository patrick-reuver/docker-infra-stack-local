# -----------------------------------------------------------------------------
# Infra Stack Environment Template
# Copy this file to infra_stack_application/.env and replace all change_me values.
# Generate strong secrets with one of:
#   openssl rand -hex 32
#   openssl rand -base64 32
# -----------------------------------------------------------------------------

# Postgres (admin/root user used for provisioning and maintenance)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_admin
POSTGRES_DEFAULT_DB=postgres

# Redis (single shared Redis instance for app stacks)
REDIS_PASSWORD=change_me_redis_runtime

# MinIO root/admin credentials (only for provisioning/admin tasks)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_admin

# Monitoring credentials (reserved for later when Grafana is enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin

# Shared app runtime credentials for Twenty onboarding
# Keep one DB user and one S3 user if you want low operational complexity.
TWENTY_DB_USER=apps_rw_user
TWENTY_DB_NAME=twenty_db
TWENTY_DB_PASSWORD=change_me_twenty_db_runtime

MINIO_APPS_USER=apps_s3_user
MINIO_APPS_PASSWORD=change_me_minio_app_runtime
MINIO_TWENTY_BUCKET=twenty
