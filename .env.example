# =============================================================================
# docker-infra-stack — Root Environment Template
# =============================================================================
# Copy this file to .env and replace all change_me values.
# Generate strong secrets with: openssl rand -hex 32  OR  openssl rand -base64 32
#
# SECRET MODEL:
# - Production: All application secrets live in Infisical (paths: /langfuse, /presidio, /clickhouse, /infisical)
# - Local dev without Infisical: Uncomment the "FALLBACK" section below and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# INFRASTRUCTURE SHARED (used by infra_stack_application/docker-compose.yml)
# -----------------------------------------------------------------------------

# Postgres admin (provisioning and maintenance only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_admin
POSTGRES_DEFAULT_DB=postgres

# Postgres shared runtime user (used by all app stacks)
POSTGRES_APP_USER=apps_rw_user
POSTGRES_APP_PASSWORD=change_me_postgres_app_runtime

# Redis shared runtime
REDIS_PASSWORD=change_me_redis_runtime

# MinIO admin (provisioning and maintenance only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_admin

# MinIO shared runtime user (used by all app stacks)
MINIO_APPS_USER=apps_s3_user
MINIO_APPS_PASSWORD=change_me_minio_app_runtime

# Shared S3 config for app stacks (EU-oriented defaults)
# Only STORAGE_S3_NAME changes per app/bucket.
STORAGE_TYPE=s3
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY_ID=apps_s3_user
STORAGE_S3_SECRET_ACCESS_KEY=change_me_minio_app_runtime

# Monitoring credentials (reserved for later when Grafana is enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin

# -----------------------------------------------------------------------------
# INFISICAL MACHINE IDENTITY BOOTSTRAP (shared by all services)
# These are the ONLY values needed in each service's .env —
# application secrets are fetched from Infisical at container startup.
# -----------------------------------------------------------------------------

INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_HOST_URL=http://infisical:8080
INFISICAL_PROJECT_ID=replace-with-infisical-project-id
# Optional explicit alternatives for newer Infisical API params:
# INFISICAL_WORKSPACE_ID=replace-with-infisical-workspace-id
# INFISICAL_PROJECT_SLUG=replace-with-infisical-project-slug
INFISICAL_ENV=local

# -----------------------------------------------------------------------------
# FALLBACK: LOCAL DEV WITHOUT INFISICAL (comment out when using Infisical)
# Application secrets that would normally come from Infisical.
# Only use if Infisical is NOT running.
# -----------------------------------------------------------------------------

# Langfuse secrets (path: /langfuse)
# DATABASE_URL=postgresql://apps_rw_user:change_me_postgres_app_runtime@postgres:5432/langfuse_db
# REDIS_URL=redis://:change_me_redis_runtime@redis:6379/1
# LANGFUSE_SALT=change_me_32_bytes_base64
# NEXTAUTH_SECRET=change_me_32_bytes_base64
# LANGFUSE_PUBLIC_KEY=pk_lf_xxx
# LANGFUSE_SECRET_KEY=sk_lf_xxx
# S3_ACCESS_KEY_ID=apps_s3_user
# S3_SECRET_ACCESS_KEY=change_me_minio_app_runtime
# S3_BUCKET=langfuse
# S3_ENDPOINT=http://minio:9000
# S3_REGION=eu-central-1
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# Presidio secrets (path: /presidio)
# PRESIDIO_LOG_LEVEL=INFO
# SPACY_MODEL=de_core_news_lg
# TRANSFORMERS_MODEL=dslim/bert-base-NER
# PRESIDIO_CUSTOM_RECOGNIZERS_ENABLED=true

# ClickHouse secrets (path: /clickhouse)
# CLICKHOUSE_DB=langfuse
# CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
# CLICKHOUSE_USER=langfuse

# Infisical app secrets (path: /infisical)
# ENCRYPTION_KEY=change_me_32_hex_chars_minimum
# AUTH_SECRET=change_me_base64_secret