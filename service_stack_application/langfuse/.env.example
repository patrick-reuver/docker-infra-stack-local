# -----------------------------------------------------------------------------
# Langfuse Observability Environment Template
# Copy this file to langfuse/.env and replace all change_me values.
# Generate strong secrets with one of:
#   openssl rand -hex 32
#   openssl rand -base64 32
# Secrets should be managed via Infisical at path: /langfuse
# -----------------------------------------------------------------------------

# Core Application
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
LANGFUSE_LOG_LEVEL=info

# Database (Shared Postgres - dedicated database: langfuse_db)
# Provisioned via: psql -U apps_rw_user -d postgres -c "CREATE DATABASE langfuse_db;"
# DATABASE_URL=postgresql://apps_rw_user:change_me@postgres:5432/langfuse_db?schema=public

# Redis (Shared Redis - dedicated database: 1)
# REDIS_URL=redis://:change_me@redis:6379/1

# Encryption & Authentication
# Generate with: openssl rand -base64 32
LANGFUSE_SALT=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# API Keys (Generated after first project creation in Langfuse UI)
# LANGFUSE_PUBLIC_KEY=pk_lf_change_me
# LANGFUSE_SECRET_KEY=sk_lf_change_me

# Optional: External ClickHouse for analytics (disabled by default)
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change_me

# Optional: S3 for file storage (uses shared MinIO)
# S3_BUCKET=langfuse
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=change_me
# S3_SECRET_ACCESS_KEY=change_me
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Infisical Secret Path: /langfuse (project: docker-infra-stack, env: development)
# The following secrets should be stored in Infisical and injected at runtime:
# - DATABASE_URL
# - REDIS_URL
# - LANGFUSE_SALT
# - NEXTAUTH_SECRET
# - LANGFUSE_PUBLIC_KEY (after project creation)
# - LANGFUSE_SECRET_KEY (after project creation)
# - LANGFUSE_LOG_LEVEL (default: info)
# - S3_* (if using MinIO for file storage)
# - CLICKHOUSE_* (if using ClickHouse for analytics)
# -----------------------------------------------------------------------------