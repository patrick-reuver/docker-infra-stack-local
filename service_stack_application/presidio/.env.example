# -----------------------------------------------------------------------------
# Presidio PII Service Environment Template
# Machine Identity credentials only - secrets injected from Infisical at runtime
# Create Machine Identity in Infisical UI: Project Settings → Machine Identities
# Grant access to folder: /presidio
# -----------------------------------------------------------------------------

# Infisical Machine Identity (Universal Auth)
INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_HOST_URL=http://infisical:8080
INFISICAL_PROJECT_ID=replace-with-infisical-project-id
# Optional explicit alternatives for newer Infisical API params:
# INFISICAL_WORKSPACE_ID=replace-with-infisical-workspace-id
# INFISICAL_PROJECT_SLUG=replace-with-infisical-project-slug
INFISICAL_ENV=local
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=replace-with-presidio-machine-identity-client-id
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=replace-with-presidio-machine-identity-client-secret

# Optional: Override Infisical folder path (default: /presidio)
# INFISICAL_SECRET_PATH=/presidio
