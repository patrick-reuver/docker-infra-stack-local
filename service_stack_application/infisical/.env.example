# -----------------------------------------------------------------------------
# Infisical local environment template
# Copy to infisical/.env and replace all change_me values before first startup.
# Generate strong secrets with one of:
#   openssl rand -hex 16
#   openssl rand -base64 32
# -----------------------------------------------------------------------------

# Public URL exposed through the shared Traefik instance
SITE_URL=http://infisical.localhost

# Shared infra dependencies
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_postgres_admin
DB_HOST=postgres
DB_PORT=5432
DB_NAME=infisical_db
DB_USER=apps_rw_user
DB_PASSWORD=change_me_postgres_app_runtime
DB_PASSWORD_URLENCODED=change_me_percent_encoded_postgres_app_runtime
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_runtime

# Infisical secrets
ENCRYPTION_KEY=change_me_32_hex_chars_minimum
AUTH_SECRET=change_me_base64_secret

# Optional image pin
INFISICAL_IMAGE_TAG=latest
