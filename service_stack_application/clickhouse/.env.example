# -----------------------------------------------------------------------------
# ClickHouse Runtime Bootstrap Environment Template
# Machine Identity credentials only - ClickHouse secrets are fetched from
# Infisical at container startup from path: /clickhouse
# -----------------------------------------------------------------------------

# Infisical Machine Identity (Universal Auth)
INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_HOST_URL=http://infisical:8080
INFISICAL_PROJECT_ID=replace-with-infisical-project-id
# Optional explicit alternatives for newer Infisical API params:
# INFISICAL_WORKSPACE_ID=replace-with-infisical-workspace-id
# INFISICAL_PROJECT_SLUG=replace-with-infisical-project-slug
INFISICAL_ENV=local
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=replace-with-clickhouse-machine-identity-client-id
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=replace-with-clickhouse-machine-identity-client-secret

# Optional: Override Infisical folder path (default: /clickhouse)
# INFISICAL_SECRET_PATH=/clickhouse
