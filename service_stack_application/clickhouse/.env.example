# -----------------------------------------------------------------------------
# ClickHouse Analytics Environment Template
# Copy this file to clickhouse/.env and replace all change_me values.
# Generate strong secrets with one of:
#   openssl rand -hex 32
#   openssl rand -base64 32
# Secrets should be managed via Infisical at path: /clickhouse
# -----------------------------------------------------------------------------

# ClickHouse Configuration
CLICKHOUSE_DB=langfuse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Infisical Secret Path: /clickhouse (project: docker-infra-stack, env: development)
# The following secrets should be stored in Infisical and injected at runtime:
# - CLICKHOUSE_USER
# - CLICKHOUSE_PASSWORD
# -----------------------------------------------------------------------------